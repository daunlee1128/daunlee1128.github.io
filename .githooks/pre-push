#!/usr/bin/env bash
# pre-push: push 되는 각 ref 의 트리 전체를 scripts/check-publish.sh 로 검사한다.
# 설치: git config core.hooksPath .githooks   (README)
set -u
ROOT=$(git rev-parse --show-toplevel)
zero=$(printf '0%.0s' $(seq 1 40))
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # ref 삭제
  echo "check-publish: $local_ref ($(git rev-parse --short "$local_sha"))" >&2
  "$ROOT/scripts/check-publish.sh" --tree "$local_sha" || status=1
done
exit $status
